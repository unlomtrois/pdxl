{
  "name": "pdxl",
  "displayName": "pdxl",
  "description": "Live diagnostics for Paradox script (CK3, ...) via the pdxl language server.",
  "version": "0.49.3",
  "publisher": "unlomtrois",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlomtrois/pdxl"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.mod",
    "workspaceContains:**/descriptor.mod",
    "workspaceContains:pdxl.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pdxl.showServerLog",
        "title": "pdxl: Show Server Log",
        "category": "pdxl"
      }
    ],
    "configuration": {
      "title": "pdxl",
      "properties": {
        "pdxl.serverPath": {
          "type": "string",
          "default": "pdxl",
          "description": "Path to the pdxl executable (on PATH by default)."
        },
        "pdxl.gamePath": {
          "type": "string",
          "default": "",
          "description": "Path to the vanilla game directory (e.g. .../Crusader Kings III/game). Used to resolve references against base-game definitions."
        },
        "pdxl.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Log level for the pdxl language server."
        }
      }
    },
    "languages": [
      {
        "id": "pdxl-gui",
        "aliases": [
          "Paradox GUI",
          "pdxgui"
        ],
        "extensions": [
          ".gui"
        ],
        "configuration": "./language-configuration-gui.json"
      }
    ],
    "configurationDefaults": {
      "[pdxl-gui]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vsix": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0"
  }
}
