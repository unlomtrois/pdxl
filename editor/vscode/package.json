{
  "name": "pdxl",
  "displayName": "pdxl",
  "description": "Live diagnostics for Paradox script (CK3, ...) via the pdxl language server.",
  "version": "0.75.0",
  "publisher": "unlomtrois",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unlomtrois/pdxl"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pdxl.showServerLog",
        "title": "pdxl: Show Server Log",
        "category": "pdxl"
      },
      {
        "command": "pdxl.installServer",
        "title": "pdxl: Install/Update Language Server",
        "category": "pdxl"
      },
      {
        "command": "pdxl.pickServerPath",
        "title": "pdxl: Pick Server Binary Path",
        "category": "pdxl"
      }
    ],
    "configuration": {
      "title": "pdxl",
      "properties": {
        "pdxl.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the pdxl executable. Empty (default) = use the extension-managed binary (downloaded from GitHub releases), falling back to `pdxl` on PATH."
        },
        "pdxl.gamePath": {
          "type": "string",
          "default": "",
          "description": "Legacy: the CK3 vanilla game directory (predates multi-game; only used for CK3 workspaces). Prefer pdxl.gamePathCk3 / pdxl.gamePathEu5."
        },
        "pdxl.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Log level for the pdxl language server."
        },
        "pdxl.game": {
          "type": "string",
          "enum": [
            "auto",
            "ck3",
            "eu5"
          ],
          "default": "auto",
          "description": "Which game this workspace targets (selects the server binary; the schema is compiled in). \"auto\" detects the EU5-era mod layout (.metadata/metadata.json or in_game/main_menu roots) and falls back to CK3."
        },
        "pdxl.gamePathCk3": {
          "type": "string",
          "default": "",
          "description": "CK3 vanilla game directory (…/Crusader Kings III/game). Empty = legacy pdxl.gamePath, then the default Steam locations."
        },
        "pdxl.gamePathEu5": {
          "type": "string",
          "default": "",
          "description": "EU5 vanilla game directory (…/Europa Universalis V/game). Empty = probed from the default Steam locations."
        }
      }
    },
    "languages": [
      {
        "id": "pdxl-gui",
        "aliases": [
          "Paradox GUI",
          "pdxgui"
        ],
        "extensions": [
          ".gui"
        ],
        "configuration": "./language-configuration-gui.json"
      }
    ],
    "configurationDefaults": {
      "[pdxl-gui]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "vsix": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.99.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0"
  }
}
