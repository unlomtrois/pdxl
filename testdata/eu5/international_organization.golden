compagna_communis_ianuensis = {
  has_target = no
  unique = yes
  expel_members_who_are_targets_of_other_members = no
  show_leave_message = yes
  use_laws_as_join_reason = no
  show_as_overlord_on_map_trigger = {
    always = yes
  }
  has_parliament = yes
  parliament_type = cci_compagna_consilium
  resolution_widget = parliament
  has_dynastic_power = no
  has_leader_country = yes
  leader_title_key = "COMPAGNA_LEADER"
  leader_type = country
  use_regnal_number = no
  leader_change_trigger_type = timed
  leader_change_method = score
  months_between_leader_changes = 120
  disband_if_no_leader = no
  override_ruler_title = no
  leader_score = {
    value = great_power_score
    if = {
      limit = {
        this = c:GEN
      }
      add = {
        desc = "SEAT_OF_THE_COMPAGNA"
        value = 50
      }
    }
    add = {
      desc = "TRADE_POWER"
      value = monthly_trade_income
    }
  }
  can_lead_trigger = {
    is_member_of_international_organization = scope:recipient
    OR = {
      has_special_status_in_international_organization = {
        type = special_status:cci_superba
        international_organization = scope:recipient
      }
      has_special_status_in_international_organization = {
        type = special_status:cci_ghazaria
        international_organization = scope:recipient
      }
      has_special_status_in_international_organization = {
        type = special_status:cci_state_bank
        international_organization = scope:recipient
      }
    }
  }
  special_statuses_implemented = {
    cci_superba
    cci_ghazaria
    cci_state_bank
    cci_maona
  }
  only_leader_country_joins_offensive_wars = yes
  join_defensive_wars_always = {
    scope:actor ?= {
      OR = {
        has_special_status_in_international_organization = {
          type = special_status:cci_superba
          international_organization = root
        }
        has_special_status_in_international_organization = {
          type = special_status:cci_ghazaria
          international_organization = root
        }
      }
    }
  }
  join_defensive_wars_auto_call = {
    scope:target ?= {
      NOT = {
        is_member_of_international_organization = root
      }
    }
  }
  gives_military_access_to_all_when_at_war = yes
  can_declare_war = {
    trigger_if = {
      limit = {
        scope:attacker = {
          is_ai = yes
        }
        scope:attacker = {
          is_member_of_international_organization = scope:recipient
        }
        scope:defender = {
          is_member_of_international_organization = scope:recipient
        }
      }
      scope:attacker = {
        has_casus_belli_on = scope:defender
      }
    }
    trigger_else = {
      always = yes
    }
  }
  create_visible_trigger = {
    always = no
  }
  invite_visible_trigger = {
    always = no
  }
  invite_enabled_trigger = {
    always = no
  }
  can_join_trigger = {
    OR = {
      is_subject_of = c:GEN
    }
  }
  can_leave_trigger = {
    always = no
  }
  auto_leave_trigger = {
    always = no
  }
  auto_disband_trigger = {
    NOT = {
      country_exists = c:GEN
    }
  }
  modifier = {
    block_from_change_to_kingdom_rank = yes
    block_from_change_to_empire_rank = yes
    block_from_change_to_duchy_rank = yes
  }
  leader_modifier = {
    great_power_score_exempt_from_forfeit = 15
    diplomatic_capacity = 1
    max_diplomats = 1
    trade_efficiency = 0.10
    monthly_prestige = 0.1
    allowed_alliance = yes
    allowed_guarantee = yes
    allowed_enforce_peace = yes
  }
  non_leader_modifier = {
    trade_efficiency = 0.05
  }
  international_organization_modifier = {
  }
  variables = {
    communal_unity = {
      format = "COMMUNAL_UNITY_DISPLAY"
      change_format = "VARIABLE_CHANGE_FORMAT"
      min = 0
      max = 100
      start = 60
      monthly_change = {
        add = {
          desc = "STABLE_LEADERSHIP"
          if = {
            limit = {
              international_organization_has_leader = yes
              leader_country ?= {
                stability >= 50
              }
            }
            value = 0.05
          }
        }
        add = {
          desc = "TRADE_PROSPERITY"
          if = {
            limit = {
              international_organization_has_leader = yes
              leader_country ?= {
                monthly_trade_income >= 20
              }
            }
            value = 0.03
          }
        }
        add = {
          desc = "COMPACT_ORGANIZATION"
          if = {
            limit = {
              total_members <= 4
            }
            value = 0.02
          }
        }
        subtract = {
          desc = "guelphs_and_ghibellines"
          if = {
            limit = {
              is_situation_active = situation:guelphs_and_ghibellines
            }
            value = 0.10
          }
        }
        subtract = {
          desc = "LEADER_AT_WAR"
          if = {
            limit = {
              international_organization_has_leader = yes
              leader_country ?= {
                at_war = yes
              }
            }
            value = 0.05
          }
          else = {
            value = 0
          }
        }
        if = {
          limit = {
            international_organization_has_leader = no
          }
          subtract = {
            desc = "NO_LEADERSHIP"
            value = 0.2
          }
        }
      }
    }
  }
  show_on_diplomatic_map = yes
  antagonism_towards_leader_modifier = 0.75
  antagonism_modifier_for_taking_land_from_fellow_member = 2.0
  antagonism_modifier_for_taking_land_from_member_as_outsider = 1.5
  no_cb_price_modifier_for_fellow_member = 2
  opinion_bonus = 15
  allow_member_annexation = no
  annexation_min_years_before = {
    value = 20
  }
  can_annex_members = {
    always = no
  }
  on_joined = {
  }
  on_left = {
  }
  monthly_effect = {
  }
  ai_desire_to_join = {
    add = {
      desc = "IS_GENOESE_SUBJECT"
      if = {
        limit = {
          is_subject_of = c:GEN
        }
        value = 100
      }
    }
    add = {
      desc = "OPINION_OF_GENOA"
      if = {
        limit = {
          country_exists = c:GEN
        }
        value = "opinion(c:GEN)"
        multiply = 0.5
      }
    }
    subtract = {
      desc = "IS_AT_WAR"
      if = {
        limit = {
          at_war = yes
        }
        value = 1000
      }
    }
  }
  ai_desire_to_allow_new_member = {
    add = {
      desc = "BASE_DESIRE"
      value = 50
    }
  }
  ai_desire_to_attack_other_members = {
    subtract = {
      desc = "COMPAGNA_SOLIDARITY"
      value = 200
    }
    if = {
      limit = {
        scope:recipient = {
          var:communal_unity < 20
        }
      }
      add = {
        desc = "LOW_COMMUNAL_UNITY"
        value = 150
      }
    }
  }
  ai_issue_voting_bias = {
  }
}
